# =====================================
# JUPYTER NOTEBOOK
# =====================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# =====================================
# ĐẶC THÙ DỰ ÁN ML & Y TẾ (QUAN TRỌNG)
# =====================================
# Không đưa dữ liệu thô và dữ liệu xử lý lên Git (tránh nặng ổ đĩa và bảo mật dữ liệu eICU)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Không đưa các file trọng số mô hình nặng lên Git
checkpoints/*
!checkpoints/.gitkeep

# Không đưa các biểu đồ/kết quả xuất thô lên Git
outputs/*
!outputs/.gitkeep

document/references/*
!document/references/.gitkeep
!document/DATA_PROCESSING.md